<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Favorit1">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Favorit"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvJumlahFavorit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Memuat favorit..."
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:layout_marginBottom="20dp"/>

            <LinearLayout
                android:id="@+id/containerDaftarFavorit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:weightSum="4"
        android:gravity="center">

        <TextView
            android:id="@+id/navEvent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Event"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#4B5563"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/navPeta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Peta"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#4B5563"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/navFavorit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Favorit"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#7C3AED"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/navProfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Profil"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#4B5563"
            android:textStyle="bold"/>

    </LinearLayout>

</RelativeLayout>