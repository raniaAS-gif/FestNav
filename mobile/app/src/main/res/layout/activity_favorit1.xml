<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:background="#FFFFFF"
    tools:context=".Favorit1">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="80dp">

        <!-- Latar Belakang Gambar Favorit -->
        <ImageView
            android:id="@+id/imgBackgroundFavorit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:src="@drawable/fav1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Menu Navigasi Bawah (Event, Peta, Favorit, Profil) -->
        <!-- Tombol Event -->
        <View
            android:id="@+id/navEvent"
            android:layout_width="65dp"
            android:layout_height="50dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="450dp"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toTopOf="@id/imgBackgroundFavorit"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Tombol Peta -->
        <View
            android:id="@+id/navPeta"
            android:layout_width="65dp"
            android:layout_height="50dp"
            android:layout_marginTop="450dp"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toTopOf="@id/imgBackgroundFavorit"
            app:layout_constraintStart_toEndOf="@id/navEvent"
            app:layout_constraintEnd_toStartOf="@id/navFavorit" />

        <!-- Tombol Favorit -->
        <View
            android:id="@+id/navFavorit"
            android:layout_width="65dp"
            android:layout_height="50dp"
            android:layout_marginTop="450dp"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toTopOf="@id/imgBackgroundFavorit"
            app:layout_constraintStart_toEndOf="@id/navPeta"
            app:layout_constraintEnd_toStartOf="@id/navProfil" />

        <!-- Tombol Profil -->
        <View
            android:id="@+id/navProfil"
            android:layout_width="65dp"
            android:layout_height="50dp"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="450dp"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toTopOf="@id/imgBackgroundFavorit"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>