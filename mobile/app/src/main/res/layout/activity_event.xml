<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Event">

    <!-- Konten Utama yang Bisa Di-scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigation"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Sapaan & Judul -->
            <TextView
                android:id="@+id/tvHaloUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Halo, Pengunjung"
                android:textSize="14sp"
                android:textColor="#7C3AED"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mau ke festival mana?"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="16dp"/>

            <!-- Kolom Pencarian (Search Bar) -->
            <EditText
                android:id="@+id/etSearchEventPage"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Cari event atau festival..."
                android:textSize="14sp"
                android:textColor="#000000"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:background="#F3F4F6"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp"/>

            <!-- Tombol Kategori (Horizontal ScrollView) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCatSemua"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Semua"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#7C3AED"
                        android:layout_marginRight="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>

                    <Button
                        android:id="@+id/btnCatMusik"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Musik"
                        android:textSize="12sp"
                        android:textColor="#4B5563"
                        android:backgroundTint="#F3F4F6"
                        android:layout_marginRight="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>

                    <Button
                        android:id="@+id/btnCatMaraton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Maraton"
                        android:textSize="12sp"
                        android:textColor="#4B5563"
                        android:backgroundTint="#F3F4F6"
                        android:layout_marginRight="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>

                    <Button
                        android:id="@+id/btnCatLainnya"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Lainnya"
                        android:textSize="12sp"
                        android:textColor="#4B5563"
                        android:backgroundTint="#F3F4F6"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- CONTAINER HASIL PENCARIAN / DAFTAR EVENT -->
            <LinearLayout
                android:id="@+id/layoutDaftarEvent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- CARD EVENT 1: Dies Natalis Udayana -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardEventDiesUdayana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:radius="16dp"
                    android:elevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:background="#FFFFFF"
                        android:gravity="center_vertical">

                        <!-- Logo / Gambar Event 1 -->
                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="#EEF2FF"
                            android:padding="12dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            android:scaleType="centerInside"
                            android:layout_marginRight="14dp"
                            android:contentDescription="Logo Event 1"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" Interaktif "
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:background="#0066FF"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                android:layout_marginBottom="6dp"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Dies Natalis Udayana"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:layout_marginBottom="2dp"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="21 Oktober - 31 Desember 2026\nRektorat Universitas Udayana"
                                android:textSize="11sp"
                                android:textColor="#6B7280"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- CARD EVENT 2: Pernikahan Sita -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardEventPernikahanSita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:radius="16dp"
                    android:elevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:background="#FFFFFF"
                        android:gravity="center_vertical">

                        <!-- Logo / Gambar Event 2 -->
                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="#FDF2F8"
                            android:padding="12dp"
                            android:src="@android:drawable/ic_menu_my_calendar"
                            android:scaleType="centerInside"
                            android:layout_marginRight="14dp"
                            android:contentDescription="Logo Event 2"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" Direktori "
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:background="#EC4899"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                android:layout_marginBottom="6dp"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Pernikahan Sita"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:layout_marginBottom="2dp"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="4 November - 5 November 2026\nAula Wedding Denpasar, Lt. 2"
                                android:textSize="11sp"
                                android:textColor="#6B7280"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- TAMPILAN KETIKA EVENT TIDAK DITEMUKAN -->
            <LinearLayout
                android:id="@+id/layoutStateKosong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <!-- Lingkaran Ilustrasi Pencarian Kosong -->
                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:background="#F3F4F6"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍"
                        android:textSize="50sp"
                        android:layout_gravity="center"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Event tidak ditemukan"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvPesanKosongDetail"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:text="Tidak ada hasil untuk pencarian ini. Coba kata kunci lain atau ubah filter."
                    android:textSize="13sp"
                    android:textColor="#6B7280"
                    android:textAlignment="center"
                    android:layout_marginBottom="24dp"/>

                <Button
                    android:id="@+id/btnResetPencarian"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="Reset pencarian"
                    android:textColor="#7C3AED"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    style="?android:attr/buttonStyleSmall"
                    android:elevation="0dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar (4 Tombol di Bawah) -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:weightSum="4"
        android:gravity="center">

        <!-- 1. Tombol Event (Aktif Ungu) -->
        <TextView
            android:id="@+id/navEvent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Event"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#7C3AED"
            android:textStyle="bold"/>

        <!-- 2. Tombol Peta -->
        <TextView
            android:id="@+id/navPeta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Peta"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#4B5563"
            android:textStyle="bold"/>

        <!-- 3. Tombol Favorit -->
        <TextView
            android:id="@+id/navFavorit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Favorit"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#4B5563"
            android:textStyle="bold"/>

        <!-- 4. Tombol Profil -->
        <TextView
            android:id="@+id/navProfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Profil"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#4B5563"
            android:textStyle="bold"/>

    </LinearLayout>

</RelativeLayout>