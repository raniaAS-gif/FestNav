<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF"
    tools:context=".LupaSandi">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Tombol Kembali (<) -->
        <TextView
            android:id="@+id/btnKembali"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="&lt;"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginBottom="24dp"/>

        <!-- Judul -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lupa kata sandi?"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Masukkan email akunmu. Kami akan mengirim tautan untuk membuat kata sandi baru."
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:layout_marginBottom="32dp"/>

        <!-- Label & Input Email -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etEmailLupa"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="nama@gmail.com"
            android:inputType="textEmailAddress"
            android:background="@android:drawable/edit_text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="28dp"/>

        <!-- Tombol Kirim Tautan Reset -->
        <Button
            android:id="@+id/btnKirimReset"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="#7C3AED"
            android:text="Kirim tautan reset"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="40dp"/>

        <!-- Footer: Ingat kata sandimu? Masuk -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingat kata sandimu? "
                android:textSize="13sp"
                android:textColor="#6B7280"/>

            <TextView
                android:id="@+id/btnMasukLupa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Masuk"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#7C3AED"
                android:padding="4dp"/>
        </LinearLayout>

    </LinearLayout>

</ScrollView>